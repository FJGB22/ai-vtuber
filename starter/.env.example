# ============================================================
#  THIS FILE IS THE TEMPLATE. The real one lives OUTSIDE the project:
#
#      C:\Users\<you>\.secrets\vtuber.env      (Windows)
#      ~/.secrets/vtuber.env                   (macOS / Linux)
#
#  A key kept out of the project folder cannot ride along in a git commit,
#  a zip you share, or a folder you hand to a tool. Set VTUBER_ENV if you
#  want it somewhere else.
#
#  No discrete GPU? Read LAPTOP-SETUP.md. Short answer:
#  use a cloud brain, keep everything else local. Option A below.
# ============================================================

# ---- A) Cloud brain: RECOMMENDED on a laptop without an NVIDIA GPU ----
# Fast (300-600ms to first token), cheap (single-digit cents per hour),
# and it leaves your CPU free for speech recognition.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-key-here
LLM_MODEL=gemini-3.5-flash-lite
# Model names go stale fast. If you get a 404, the error message names the
# replacement - just paste that in here.

# ---- B) OpenAI ----
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ---- C) Local via Ollama: only worth it with a real GPU ----
# On CPU an 8B model produces ~10 tokens/sec. A short reply takes 12 seconds.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b

CHAR_NAME=Mika
PERSONA_FILE=persona.md

# ---- voice ----
# edge-tts: free, no key, no local compute. Swap to Piper for offline (see LAPTOP-SETUP.md).
TTS_VOICE=en-US-AnaNeural
TTS_RATE=+18%
TTS_PITCH=+8Hz

# ---- ears ----
# base.en on an 8-core Zen 4 CPU is comfortable. Try small.en if you want
# better accuracy and don't mind a bit more delay.
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
VAD_THRESHOLD=0.015

# ---- face ----
VTS_ENABLED=false
VTS_URL=ws://localhost:8001
